<?xml version="1.0"?>
<sdf version="1.9">
  <world name="warehouse">
    <physics name="warehouse_physics" type="ignored">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <scene>
      <ambient>0.55 0.55 0.55 1</ambient>
      <background>0.2 0.25 0.3 1</background>
    </scene>
    <light name="overhead" type="directional">
      <pose>0 0 8 0 0 0</pose>
      <direction>-0.25 0.15 -1</direction>
      <diffuse>0.8 0.8 0.8 1</diffuse>
    </light>

    <model name="building">
      <static>true</static>
      <link name="structure">
        <collision name="floor_collision">
          <pose>0 0 -0.05 0 0 0</pose>
          <geometry><box><size>14 10 0.1</size></box></geometry>
        </collision>
        <visual name="floor">
          <pose>0 0 -0.05 0 0 0</pose>
          <geometry><box><size>14 10 0.1</size></box></geometry>
          <material><diffuse>0.42 0.44 0.45 1</diffuse></material>
        </visual>
        <collision name="east_collision">
          <pose>7 0 0.8 0 0 0</pose>
          <geometry><box><size>0.2 10.2 1.6</size></box></geometry>
        </collision>
        <visual name="east_wall">
          <pose>7 0 0.8 0 0 0</pose>
          <geometry><box><size>0.2 10.2 1.6</size></box></geometry>
        </visual>
        <collision name="west_collision">
          <pose>-7 0 0.8 0 0 0</pose>
          <geometry><box><size>0.2 10.2 1.6</size></box></geometry>
        </collision>
        <visual name="west_wall">
          <pose>-7 0 0.8 0 0 0</pose>
          <geometry><box><size>0.2 10.2 1.6</size></box></geometry>
        </visual>
        <collision name="north_collision">
          <pose>0 5 0.8 0 0 0</pose>
          <geometry><box><size>13.8 0.2 1.6</size></box></geometry>
        </collision>
        <visual name="north_wall">
          <pose>0 5 0.8 0 0 0</pose>
          <geometry><box><size>13.8 0.2 1.6</size></box></geometry>
        </visual>
        <collision name="south_collision">
          <pose>0 -5 0.8 0 0 0</pose>
          <geometry><box><size>13.8 0.2 1.6</size></box></geometry>
        </collision>
        <visual name="south_wall">
          <pose>0 -5 0.8 0 0 0</pose>
          <geometry><box><size>13.8 0.2 1.6</size></box></geometry>
        </visual>
        <visual name="receiving_bay">
          <pose>-4.5 -3.5 0.004 0 0 0</pose>
          <geometry><box><size>1.8 1.6 0.005</size></box></geometry>
          <material><ambient>0.94 0.65 0.18 1</ambient><diffuse>0.94 0.65 0.18 1</diffuse></material>
        </visual>
        <visual name="delivery_bay">
          <pose>4.5 3.5 0.004 0 0 0</pose>
          <geometry><box><size>1.8 1.6 0.005</size></box></geometry>
          <material><ambient>0.16 0.63 0.47 1</ambient><diffuse>0.16 0.63 0.47 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- The shelf rows give the LiDAR repeatable geometry on either side of the main aisle. -->
    <model name="shelf_north">
      <static>true</static>
      <pose>0 1.5 0.65 0 0 0</pose>
      <link name="rack">
        <collision name="rack_collision">
          <geometry><box><size>5.0 0.8 1.3</size></box></geometry>
        </collision>
        <visual name="rack">
          <geometry><box><size>5.0 0.8 1.3</size></box></geometry>
          <material><ambient>0.18 0.3 0.52 1</ambient><diffuse>0.18 0.3 0.52 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="shelf_south">
      <static>true</static>
      <pose>0 -1.5 0.65 0 0 0</pose>
      <link name="rack">
        <collision name="rack_collision">
          <geometry><box><size>5.0 0.8 1.3</size></box></geometry>
        </collision>
        <visual name="rack">
          <geometry><box><size>5.0 0.8 1.3</size></box></geometry>
          <material><ambient>0.18 0.3 0.52 1</ambient><diffuse>0.18 0.3 0.52 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
