<?xml version="1.0"?>
<robot name="aisleops" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:property name="wheel_radius" value="0.09"/>
  <xacro:property name="wheel_width" value="0.045"/>
  <xacro:property name="wheel_separation" value="0.41"/>
  <xacro:property name="base_height" value="0.12"/>

  <material name="teal"><color rgba="0.04 0.42 0.44 1"/></material>
  <material name="rubber"><color rgba="0.07 0.08 0.09 1"/></material>

  <!-- XY is the floor plane, +X is forward, and +Z is up. -->
  <link name="base_footprint"/>
  <joint name="base_mount" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${base_height}"/>
  </joint>

  <xacro:property name="body_length" value="0.48"/>
  <xacro:property name="body_width" value="0.34"/>
  <xacro:property name="body_height" value="0.14"/>
  <xacro:property name="body_mass" value="8.0"/>
  <link name="base_link">
    <inertial>
      <origin xyz="-0.035 0 0"/>
      <mass value="${body_mass}"/>
      <inertia ixx="${body_mass * (body_width**2 + body_height**2) / 12}"
               iyy="${body_mass * (body_length**2 + body_height**2) / 12}"
               izz="${body_mass * (body_length**2 + body_width**2) / 12}"
               ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <geometry><box size="${body_length} ${body_width} ${body_height}"/></geometry>
      <material name="teal"/>
    </visual>
    <collision>
      <geometry><box size="${body_length} ${body_width} ${body_height}"/></geometry>
    </collision>
  </link>

  <xacro:macro name="drive_wheel" params="side lateral">
    <xacro:property name="mass" value="0.45"/>
    <xacro:property name="cross_inertia" value="${mass * (3 * wheel_radius**2 + wheel_width**2) / 12}"/>
    <link name="${side}_wheel">
      <inertial>
        <mass value="${mass}"/>
        <inertia ixx="${cross_inertia}" iyy="${mass * wheel_radius**2 / 2}" izz="${cross_inertia}"
                 ixy="0" ixz="0" iyz="0"/>
      </inertial>
      <visual>
        <origin rpy="${pi / 2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="rubber"/>
      </visual>
      <collision>
        <origin rpy="${pi / 2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
    </link>
    <joint name="${side}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${side}_wheel"/>
      <origin xyz="0 ${lateral} ${wheel_radius - base_height}"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>
  <xacro:drive_wheel side="left" lateral="${wheel_separation / 2}"/>
  <xacro:drive_wheel side="right" lateral="${-wheel_separation / 2}"/>

  <xacro:property name="caster_radius" value="0.035"/>
  <link name="rear_skid">
    <visual>
      <geometry><sphere radius="${caster_radius}"/></geometry>
      <material name="rubber"/>
    </visual>
    <collision>
      <geometry><sphere radius="${caster_radius}"/></geometry>
    </collision>
  </link>
  <joint name="rear_skid_mount" type="fixed">
    <parent link="base_link"/>
    <child link="rear_skid"/>
    <origin xyz="-0.185 0 ${caster_radius - base_height}"/>
  </joint>
  <gazebo reference="rear_skid">
    <mu1>0.02</mu1>
    <mu2>0.02</mu2>
  </gazebo>

  <link name="base_scan">
    <visual>
      <origin xyz="0 0 -0.02"/>
      <geometry><cylinder radius="0.045" length="0.025"/></geometry>
      <material name="rubber"/>
    </visual>
  </link>
  <joint name="lidar_mount" type="fixed">
    <parent link="base_link"/>
    <child link="base_scan"/>
    <origin xyz="0.15 0 0.115"/>
  </joint>
  <gazebo reference="base_scan">
    <sensor name="lidar" type="gpu_lidar">
      <always_on>true</always_on>
      <update_rate>10</update_rate>
      <topic>/scan</topic>
      <gz_frame_id>base_scan</gz_frame_id>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>${-pi}</min_angle>
            <max_angle>${pi - 2 * pi / 360}</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.12</min>
          <max>12.0</max>
        </range>
      </lidar>
    </sensor>
  </gazebo>

  <link name="imu_link"/>
  <joint name="imu_mount" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0.04"/>
  </joint>
  <gazebo reference="imu_link">
    <sensor name="imu" type="imu">
      <always_on>true</always_on>
      <update_rate>50</update_rate>
      <topic>/imu</topic>
      <gz_frame_id>imu_link</gz_frame_id>
    </sensor>
  </gazebo>

  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>${wheel_separation}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publish_frequency>30</odom_publish_frequency>
      <min_linear_acceleration>-0.6</min_linear_acceleration>
      <max_linear_acceleration>0.6</max_linear_acceleration>
      <min_angular_acceleration>-1.5</min_angular_acceleration>
      <max_angular_acceleration>1.5</max_angular_acceleration>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>/joint_states</topic>
      <joint_name>left_wheel_joint</joint_name>
      <joint_name>right_wheel_joint</joint_name>
    </plugin>
  </gazebo>
</robot>
